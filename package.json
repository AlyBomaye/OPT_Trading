{
  "name": "opcoes-terminal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:aberto": "node scripts/dev-aberto.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsx lib/__tests__/engine.test.ts",
    "dados:sync": "node scripts/dados-sync.mjs",
    "prod:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/producao.ps1 build",
    "prod:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/producao.ps1 start",
    "prod:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/producao.ps1 stop",
    "prod:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/producao.ps1 status",
    "prod:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/producao.ps1 logs",
    "vigia": "node scripts/vigia.mjs",
    "vigia:uma-vez": "node scripts/vigia.mjs --uma-vez",
    "agendar": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agendar.ps1 instalar",
    "agendar:listar": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/agendar.ps1 listar",
    "senha": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/definir-senha.ps1",
    "backup:db": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-db.ps1",
    "agents:daily": "node scripts/agents-daily.mjs",
    "setup:db": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-db.ps1",
    "reset:senha-db": "powershell -ExecutionPolicy Bypass -File ./scripts/reset-senha-postgres.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.428.0",
    "next": "^14.2.5",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
