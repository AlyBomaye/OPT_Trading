# Copie para .env.local e preencha. NUNCA versione o .env.local — ele está no .gitignore.
# Este arquivo é um modelo: não coloque valores reais aqui.

# Senha única de acesso à plataforma (WO-37).
# Em desenvolvimento, deixar em branco libera o acesso local.
# Em produção, a plataforma NÃO sobe sem esta variável — o modo aberto nunca é o padrão.
APP_PASSWORD=

# Chave da API da Anthropic, usada pelo Gestor Global e pelo agente de Melhoria Contínua.
# Gere em https://console.anthropic.com/settings/keys
# Sem ela, o Consultor funciona em modo determinístico: os 11 agentes de regras rodam
# normalmente e só a síntese em linguagem natural fica de fora.
# Lida apenas no servidor, via process.env — nunca chega ao navegador.
ANTHROPIC_API_KEY=

# Conexão com o PostgreSQL (WO-42). Gravada automaticamente por scripts/setup-db.ps1.
# Sem ela a plataforma funciona igual, com o navegador como fonte do estado — mas sem backup do
# book e sem histórico de IV no servidor.
# Formato: postgresql://usuario:senha@localhost:5433/opcoes_terminal
DATABASE_URL=
